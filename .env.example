PORT=3000
NODE_ENV=development

# Keycloak
KEYCLOAK_REALM_URL=https://keycloak.yourdomain.com/realms/truecall
KEYCLOAK_CLIENT_ID=truecall-api

# Database
DATABASE_URL=postgresql://truecall:password@localhost:5432/truecall

# Truecaller
TC_PHONE_NUMBER=+233xxxxxxxxx
TOKEN_TTL_BUFFER_SECONDS=43200

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AES-256-GCM key — generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Region
DEFAULT_COUNTRY_CODE=GH

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=30

# Lookup cache TTL (seconds)
CACHE_TTL_SECONDS=86400

# OpenTelemetry (set in docker-compose for prod)
# OTEL_SERVICE_NAME=truecall-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
