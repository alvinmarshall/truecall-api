{
  "realm": "truecall",
  "displayName": "TrueCall",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "truecall-api",
      "name": "TrueCall API (Resource Server)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true
    },
    {
      "clientId": "truecall-shortcut",
      "name": "TrueCall Shortcut (iOS)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-shortcut-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "truecall-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "truecall-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "truecall-api-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "usermodel.clientRoleMapping.clientId": "truecall-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "resource_access.truecall-api.roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "truecall-admin",
      "name": "TrueCall Admin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-admin-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "truecall-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "truecall-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "truecall-api-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "usermodel.clientRoleMapping.clientId": "truecall-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "resource_access.truecall-api.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [],
    "client": {
      "truecall-api": [
        { "name": "lookup", "description": "Lookup role — phone lookups" },
        { "name": "admin", "description": "Admin role — token management" }
      ]
    }
  },
  "users": [
    {
      "username": "service-account-truecall-shortcut",
      "enabled": true,
      "serviceAccountClientId": "truecall-shortcut",
      "clientRoles": {
        "truecall-api": ["lookup"]
      }
    },
    {
      "username": "service-account-truecall-admin",
      "enabled": true,
      "serviceAccountClientId": "truecall-admin",
      "clientRoles": {
        "truecall-api": ["admin"]
      }
    }
  ]
}
