### ─────────────────────────────────────────────
### 1. Get Admin Token → stored as admin_token
### ─────────────────────────────────────────────
POST {{keycloakUrl}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id={{adminClientId}}&client_secret={{adminClientSecret}}

> {%
  client.test("Request executed successfully", function () {
    client.assert(response.status === 200, "Response status is not 200");
    var body = response.body;
    client.log("Token used in this request: " + body.access_token);
    client.global.set("admin_token", body.access_token);
  });
%}

### ─────────────────────────────────────────────
### 2. Get Lookup Token → stored as shortcut_token
### ─────────────────────────────────────────────
POST {{keycloakUrl}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id={{shortcutClientId}}&client_secret={{shortcutClientSecret}}

> {%
  client.test("Request executed successfully", function () {
    client.assert(response.status === 200, "Response status is not 200");
    var body = response.body;
    client.log("Token used in this request: " + body.access_token);
    client.global.set("shortcut_token", body.access_token);
  });
%}

### ─────────────────────────────────────────────
### 3. TC Token Status
### ─────────────────────────────────────────────
GET {{baseUrl}}/admin/token/status
Authorization: Bearer {{admin_token}}

### ─────────────────────────────────────────────
### 4. Request OTP (triggers SMS to TC_PHONE_NUMBER)
### ─────────────────────────────────────────────
POST {{baseUrl}}/admin/token/request-otp
Authorization: Bearer {{admin_token}}

> {%
  client.test("Request executed successfully", function () {
    client.assert(response.status === 200, "Response status is not 200");
    var body = response.body;
    client.global.set("request_id", body.requestId);
  });
%}

### ─────────────────────────────────────────────
### 5. Verify OTP — only fill in "otp", requestId auto-filled from step 4
### ─────────────────────────────────────────────
POST {{baseUrl}}/admin/token/verify-otp
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "requestId": "{{request_id}}",
  "otp": "<otp from SMS>"
}

### ─────────────────────────────────────────────
### 6. Health Check (public — no auth)
### ─────────────────────────────────────────────
GET {{baseUrl}}/health

### ─────────────────────────────────────────────
### 7. Lookup Phone Number
### ─────────────────────────────────────────────
GET {{baseUrl}}/lookup?phone=+233200000000
Authorization: Bearer {{shortcut_token}}
